[core]
    compression = 9
    whitespace = error
    preloadindex = true
	pager = delta

[push]
    autoSetupRempte = true
    default = current
    followTags = true

[pull]
    default = current
    rebase = true

[rebase]
    autoStash = true
    missingCommitsCheck = warn

[log]
    abbrevCommit = true
    showSignature = true
    graphColors = blue,yellow,cyan,magenta,green,red

[color "decorate"]
    HEAD = red
    branch = blue
    tag = yellow
    remoteBranch = magenta

[color "branch"]
    current = magenta
    local = default
    remote = green
    upstream = green
    plain = blue

[branch]
    sort = -committerdate

[tag]
    sort = -taggerdate

[pager]
    branch = false
    tag = false

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all
[interactive]
	diffFilter = delta --color-only --diff-so-fancy
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main
