// Monitors settings
output "eDP-1" {
    mode "3200x2000@60"
    variable-refresh-rate on-demand=true
    focus-at-startup
    transform "normal"
    scale 1.75
    position x=0 y=0
}
output "eDP-2" {
    mode "3200x2000@60"
    variable-refresh-rate on-demand=true
    focus-at-startup
    transform "normal"
    scale 1.75
    position x=0 y=0
}
output "Samsung Electric Company LS27B61x H4TW201463" {
    mode "2560x1440@59.951"
    transform "normal"
    position x=-2560 y=0
}
output "Dell Inc. DELL SE2722H H4DS5V3" {
    mode "1920x1080@60.00"
    transform "normal"
    position x=-1920 y=0
}
